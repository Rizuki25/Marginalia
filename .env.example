# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opsional. Origin publik aplikasi, dipakai sebagai tujuan balik OAuth.
# Kosongkan di Vercel (otomatis memakai domain deployment).
NEXT_PUBLIC_SITE_URL=

# Opsional. Pencarian buku jalan tanpa ini: Google Books dipakai tanpa key
# (kuota harian lebih kecil), lalu otomatis dialihkan ke Open Library.
# Isi key dari Google Cloud Console untuk kuota yang lebih longgar.
GOOGLE_BOOKS_API_KEY=
